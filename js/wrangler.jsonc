{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tessera",
  "main": "src/index.js",
  "compatibility_date": "2024-12-01",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TESSERA",
        "class_name": "Tessera"
      }
